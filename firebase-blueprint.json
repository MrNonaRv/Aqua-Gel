{
  "entities": {
    "Customer": {
      "title": "Customer",
      "description": "Customer entity",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "username": { "type": "string" },
        "role": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "unpaid": { "type": "number" },
        "totalGallons": { "type": "number" },
        "isLoyal": { "type": "boolean" },
        "profilePictureUrl": { "type": "string" },
        "note": { "type": "string" }
      },
      "required": ["name", "username", "role", "phone", "address"]
    },
    "Order": {
        "title": "Order",
        "description": "Order entity",
        "type": "object",
        "properties": {
            "customerId": { "type": "string" },
            "customerName": { "type": "string" },
            "status": { "type": "string" }
        },
        "required": ["customerId", "customerName", "status"]
    }
  },
  "firestore": {
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Customer records"
    },
    "/orders/{orderId}": {
        "schema": { "$ref": "#/entities/Order" },
        "description": "Order records"
    }
  }
}
