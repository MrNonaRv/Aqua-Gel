rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // For this migration, we'll allow all read and write 
      // but in a production app we'd want strict auth. 
      // Since they have custom local auth, let's keep it open for now or they will get blocked.
      allow read, write: if true;
    }
  }
}
